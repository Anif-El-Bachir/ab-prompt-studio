# AB Prompt Studio — fornecedores de IA (opcional)
# Copia para .env.local e preenche apenas os que usares.
# Estas variáveis são lidas SÓ no servidor (rotas /api/ai/*) e nunca são enviadas ao browser.
# Sem nenhuma chave, a aplicação funciona com os motores locais.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Endpoint compatível com a API OpenAI (ex.: OmniRoute em http://127.0.0.1:20128/v1, Ollama, LM Studio, vLLM)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
